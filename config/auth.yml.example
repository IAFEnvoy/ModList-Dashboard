# API 密钥配置（首次启动自动生成，请改成你自己的密钥）
# 支持直接填写明文，或在 ai.yml/mcps.yml 中使用 ${ENV_NAME} 从环境变量读取
curseforge:
  api_key: "YOUR_CURSEFORGE_API_KEY"

github:
  tokens:
    # 示例:
    # IAFEnvoy: github_pat_xxxxxxxxxxxxxxxx

codacy:
  api_token: "YOUR_CODACY_API_TOKEN"

# 管理员登录（首次启动会按这里的信息创建默认管理员）
admin:
  username: admin
  password: please-change-me
